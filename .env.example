# ========================================================
# Messliner Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your actual credentials.
# ========================================================

# Supabase Authentication & Database
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_ID

# Firebase Primary (Dining RTDB & Storage)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase Admin (Analytics, Logs & Presence)
FIREBASE_ADMIN_API_KEY=YOUR_ADMIN_FIREBASE_API_KEY
FIREBASE_ADMIN_AUTH_DOMAIN=YOUR_ADMIN_PROJECT.firebaseapp.com
FIREBASE_ADMIN_DATABASE_URL=https://YOUR_ADMIN_PROJECT-default-rtdb.firebaseio.com
FIREBASE_ADMIN_PROJECT_ID=YOUR_ADMIN_PROJECT_ID
FIREBASE_ADMIN_STORAGE_BUCKET=YOUR_ADMIN_PROJECT.firebasestorage.app
FIREBASE_ADMIN_MESSAGING_SENDER_ID=YOUR_ADMIN_MESSAGING_SENDER_ID
FIREBASE_ADMIN_APP_ID=YOUR_ADMIN_FIREBASE_APP_ID

# Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview

# BulkSMSBD Universal SMS Gateway
SMS_API_KEY=YOUR_BULKSMSBD_API_KEY
SMS_SENDER_ID=YOUR_APPROVED_SENDER_ID
SMS_RATE=0.30

# bKash Merchant Gateway
BKASH_GATEWAY_URL=https://YOUR_GATEWAY_URL.app
BKASH_LICENSE_KEY=YOUR_BKASH_GATEWAY_LICENSE_KEY
